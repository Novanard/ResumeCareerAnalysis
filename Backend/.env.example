PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# Shared endpoint requests per client per minute (single backend process).
SHARED_PROFILE_RATE_LIMIT=60
# Comma-separated trusted proxy IPs/CIDRs; leave blank for direct connections.
TRUST_PROXY=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: resume parsing remains disabled when this is blank.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
